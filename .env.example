# Postgres URI from Supabase → Connect → Transaction pooler → URI (port 6543).
# Must start with postgresql://  — never paste an https:// link.
# Replace [YOUR-PASSWORD] with your real database password (no brackets, no quotes).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional. Only needed for SEC EDGAR ingest scripts.
SEC_USER_AGENT=YourName your.email@example.com

# Optional. Layer-2 science council is scaffolded, not required to run the terminal.
POE_API_KEY=
