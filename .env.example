# Local Docker (what ./scripts/launch_terminal.sh uses if this is still a placeholder):
#   docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biotech
#
# Or a real Supabase URI (Project → Connect → Session pooler → URI).
# Must start with postgresql:// — never paste an https:// dashboard link.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional. Only needed for SEC EDGAR ingest scripts.
SEC_USER_AGENT=YourName your.email@example.com
